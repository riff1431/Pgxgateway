PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pgxdb?retryWrites=true&w=majority
CORS_ORIGIN=https://pgxgateway.com,https://www.pgxgateway.com
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
SUPERADMIN_EMAIL=superadmin@pgxgateway.com
SUPERADMIN_PASSWORD=your_superadmin_password_here
SUPERADMIN_SECRET_KEY=your_superadmin_secret_key_here
ADMIN_EMAIL=admin@pgxgateway.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET_KEY=your_admin_secret_key_here
