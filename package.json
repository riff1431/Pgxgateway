    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.4",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
